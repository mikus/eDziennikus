<!--
  ~ A real LinearLayout root, not a <merge>. Under DataBinding a <merge> include could still be
  ~ addressed by id; ViewBinding's generated bind() resolves an include's id with findViewById, and a
  ~ <merge> leaves no view to carry it, so `<include android:id="@+id/header">` in note_list_dialog
  ~ crashed with "Missing required view with ID: .../header". The root below is exactly what this
  ~ file's own tools:parentTag/tools:orientation/tools:layout_* hints always described.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="16dp"
        android:drawablePadding="8dp"
        android:textAppearance="@style/AppTheme.MaterialAlertDialog.TitleText"
        tools:drawableStartCompat="@drawable/ic_grade"
        tools:layout_height="28sp"
        tools:text="Ocena" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ownerItemList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:itemCount="1"
        tools:listitem="@layout/grades_item_grade" />
</LinearLayout>
