<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Reduced to app-owned views only: the shell (drawer, toolbar, bottom bar, FAB, sheet, the
  ~ refresh indicator and the @id/fragment container) now lives inside the ComposeView.
  ~ rootFrame survives because the app background (setAppBackground) and the seasonal
  ~ snowfall/eggfall overlays hang off it. The version badge moved into the ComposeView, so
  ~ that the drawer scrim and the bottom sheet cover it like any other content.
  -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    tools:theme="@style/AppTheme.Black">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
