<?xml version="1.0" encoding="utf-8"?>
<!--
  Unit-test variant manifest. The unit-test variant's manifest merger drops the
  production manifest's `tools:overrideLibrary` directives, so they are re-declared
  here.

  NOTE: the app's minSdk is 23 (build.gradle), not 16 as this comment used to say.
  The overridden deps declare minSdk 14-21, all at or below 23, so most of these
  entries are probably now unnecessary. They are left in place because removing
  them is a manifest change that needs its own verification, not a doc fix.

  This file is intentionally NOT packaged into the production APK — it only
  feeds the unit-test variant's merged manifest, used by Robolectric.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk
        tools:overrideLibrary="com.qifan.powerpermission.coroutines,
            com.qifan.powerpermission.core,
            androidx.test.espresso.idling.resource,
            androidx.test.monitor,
            androidx.test.core,
            androidx.test.runner,
            androidx.test.rules,
            androidx.test.ext.junit" />

</manifest>
